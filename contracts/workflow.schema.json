{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent4company.local/contracts/workflow.schema.json",
  "title": "受控 DAG 工作流",
  "type": "object",
  "required": ["id", "plugin", "display_name", "entry_nodes", "output_nodes", "nodes"],
  "properties": {
    "id": {"type": "string"},
    "plugin": {"type": "string"},
    "display_name": {"type": "string"},
    "entry_nodes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "output_nodes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "depends_on", "permissions"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["agent", "tool", "subagent", "approval", "parallel", "join", "validator"]},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
