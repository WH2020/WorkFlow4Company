{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent4company.local/contracts/plugin.schema.json",
  "title": "Agent4Company 插件清单",
  "type": "object",
  "required": [
    "api_version",
    "id",
    "version",
    "kind",
    "display_name",
    "description",
    "permissions",
    "write_permissions",
    "tools",
    "dependencies",
    "capabilities",
    "skills",
    "workflows"
  ],
  "properties": {
    "api_version": {"const": "company.platform/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "kind": {"enum": ["platform-capability", "business-domain"]},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "write_permissions": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "effect", "permissions"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "effect": {"enum": ["read", "write"]},
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {"id": {"type": "string"}, "version": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "skills": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
      "uniqueItems": true
    },
    "workflows": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
